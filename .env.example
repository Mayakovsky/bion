# Bion environment (example — copy to .env.local and fill locally; .env.local is gitignored)
#
# Two lanes, two roles against ONE dedicated, isolated local Postgres cluster:
#   - Runtime lane  (bion_rw)   : least privilege; append-only on messages/events enforced;
#                                 read-only on agents/invariants; cannot set tasks.ratified.
#   - Migration lane(bion_owner): owns the schema; runs DDL + Forces-gated writes.
#
# The cluster holds NO grant on any external/revenue database — separate instance, separate port.

# Runtime (app) connection — least-privilege role.
BION_DATABASE_URL=postgresql://bion_rw:REPLACE_ME@127.0.0.1:5433/bion

# Migration / owner connection — used by `pnpm migrate` and Forces-lane operations only.
BION_MIGRATE_URL=postgresql://bion_owner:REPLACE_ME@127.0.0.1:5433/bion

# --- Phase C: ntfy notifier (Forces supplies live values; build/test against placeholder) ---
# Auth via header only; never logged.
BION_NTFY_URL=
BION_NTFY_TOKEN=

# --- Phase D: reactive dispatch (default off; the flip off→shadow→on is Forces' call) ---
#   off     surface only: a watcher-detected failure → unratified task + notify + Desktop review.
#           No dispatch (Bion never ratifies — inv 13 / FDQ-B3).
#   shadow  as off, PLUS log the dispatch it WOULD have fired + notify. Fires nothing, spends nothing.
#   on      auto-dispatch a fix to Kov within the bounded envelope (ratified task's own branch only).
#           SPENDS API $ autonomously — bounded by the circuit breaker + loop-halt below.
BION_REACTIVE_DISPATCH=off
# 'on' envelope bounds (the circuit breaker doubles as the spend/rate ceiling):
# BION_REACTIVE_MAX=3
# BION_REACTIVE_WINDOW_MS=3600000

# --- Phase E3: Auto Mode (default off; the flip off→shadow→on is Forces' call) ---
#   off     do nothing autonomously.
#   shadow  log the pivots + dispatches Auto Mode WOULD make + notify. Spends nothing, executes nothing.
#   on      auto-dispatch ratified work to Kov within the reactive envelope (breaker/spend ceiling);
#           Desktop-owned items are QUEUED for when Forces is present, not executed.
BION_AUTO_MODE=off
